diff --git a/test/services/garment_taxonomy_test.dart b/test/services/garment_taxonomy_test.dart
new file mode 100644
index 0000000..9ca1d22
--- /dev/null
+++ b/test/services/garment_taxonomy_test.dart
@@ -0,0 +1,115 @@
+// Protects the shared garment classification used by the try-on picker, the
+// daily dress-up picker, and the avatar try-on page. Compound wording like
+// "dress shirt" must not be read as a one-piece dress, because that decides
+// both the outfit slot and the category sent to the FASHN try-on API.
+import 'package:banigoba/data/utils/garment_taxonomy.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('compound "dress" wording', () {
+    test('classifies dress shirts as tops, not dresses', () {
+      expect(garmentGroupForText('dress shirt'), 'tops');
+      expect(garmentGroupForText('Dress Shirts'), 'tops');
+      expect(garmentGroupForText('mens dress shirt'), 'tops');
+    });
+
+    test('classifies dress pants and trousers as bottoms', () {
+      expect(garmentGroupForText('dress pants'), 'bottoms');
+      expect(garmentGroupForText('dress trousers'), 'bottoms');
+      expect(garmentGroupForText('Dress Trouser'), 'bottoms');
+    });
+
+    test('classifies dress shoes as accessories', () {
+      expect(garmentGroupForText('dress shoes'), 'accessories');
+      expect(garmentGroupForText('dress boots'), 'accessories');
+    });
+
+    test('keeps plain and modified dresses as dresses', () {
+      expect(garmentGroupForText('dress'), 'dresses');
+      expect(garmentGroupForText('dresses'), 'dresses');
+      expect(garmentGroupForText('sundress'), 'dresses');
+      expect(garmentGroupForText('maxi dress'), 'dresses');
+      expect(garmentGroupForText('jumpsuit'), 'dresses');
+      expect(garmentGroupForText('one-piece'), 'dresses');
+    });
+
+    test('keeps garment-noun-then-dress wording as dresses', () {
+      // A shirt dress really is a one-piece dress, unlike a dress shirt.
+      expect(garmentGroupForText('shirt dress'), 'dresses');
+      expect(garmentGroupForText('sweater dress'), 'dresses');
+    });
+
+    test('falls back to dresses when "dress" modifies a non-garment word', () {
+      expect(garmentGroupForText('dress for summer'), 'dresses');
+      expect(garmentGroupForText('dresses on sale'), 'dresses');
+    });
+  });
+
+  group('plain category wording', () {
+    test('classifies each seller-selectable category', () {
+      expect(garmentGroupForText('tops shirts'), 'tops');
+      expect(garmentGroupForText('bottoms jeans'), 'bottoms');
+      expect(garmentGroupForText('outerwear blazers'), 'outerwear');
+      expect(garmentGroupForText('accessories hats'), 'accessories');
+      expect(garmentGroupForText('dresses none'), 'dresses');
+    });
+
+    test('classifies unknown and blank wording as other', () {
+      expect(garmentGroupForText(''), 'other');
+      expect(garmentGroupForText('   '), 'other');
+      expect(garmentGroupForText('gift card'), 'other');
+    });
+
+    test('does not read "capris" as a cap accessory', () {
+      expect(garmentGroupForText('capri pants'), 'bottoms');
+    });
+  });
+
+  group('garmentGroupForProduct', () {
+    test('combines category and subcategory before matching', () {
+      expect(
+        garmentGroupForProduct({'category': 'dress', 'subcategory': 'shirt'}),
+        'tops',
+      );
+      expect(
+        garmentGroupForProduct({'category': 'tops', 'subcategory': 'none'}),
+        'tops',
+      );
+    });
+
+    test('classifies missing category fields as other', () {
+      expect(garmentGroupForProduct({}), 'other');
+      expect(
+        garmentGroupForProduct({'category': null, 'subcategory': null}),
+        'other',
+      );
+    });
+  });
+
+  group('fashnCategoryForGroup', () {
+    test('maps wearable groups onto FASHN categories', () {
+      expect(fashnCategoryForGroup('dresses'), 'one-pieces');
+      expect(fashnCategoryForGroup('bottoms'), 'bottoms');
+      expect(fashnCategoryForGroup('tops'), 'tops');
+      expect(fashnCategoryForGroup('outerwear'), 'tops');
+    });
+
+    test('falls back to auto for groups FASHN cannot place', () {
+      expect(fashnCategoryForGroup('accessories'), 'auto');
+      expect(fashnCategoryForGroup('other'), 'auto');
+      expect(fashnCategoryForGroup('unknown'), 'auto');
+    });
+
+    test('sends a dress shirt to FASHN as a top, not a one-piece', () {
+      final product = {'category': 'dress shirt', 'subcategory': 'none'};
+
+      expect(fashnCategoryForGroup(garmentGroupForProduct(product)), 'tops');
+    });
+
+    test('sends dress pants to FASHN as bottoms', () {
+      final product = {'category': 'dress pants', 'subcategory': 'none'};
+
+      expect(fashnCategoryForGroup(garmentGroupForProduct(product)), 'bottoms');
+    });
+  });
+}
