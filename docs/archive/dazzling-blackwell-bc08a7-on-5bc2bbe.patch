@@ -0,0 +1,145 @@
+// Shared helpers for classifying a catalog product into a garment group.
+//
+// Product `category` / `subcategory` come from seller input and seeded catalog
+// data, so they are free text rather than a closed enum. The try-on picker, the
+// daily dress-up picker, and the avatar try-on page all need to agree on which
+// slot a product occupies — a top and a one-piece dress cannot both be worn in
+// the same layer. Keeping the matching here stops those three surfaces from
+// drifting apart.
+
+/// Garment slots a product can occupy, in layering order.
+const garmentGroups = <String>[
+  'dresses',
+  'tops',
+  'bottoms',
+  'outerwear',
+  'accessories',
+  'other',
+];
+
+/// Keyword groups are tested in this order, so the first match wins.
+///
+/// `dresses` deliberately stays first: a "shirt dress" or "sweater dress" is a
+/// one-piece dress, not a top. Compound terms where `dress` instead *modifies*
+/// another garment ("dress shirt", "dress pants") are resolved before this
+/// cascade runs — see [garmentGroupForText].
+const _groupKeywords = <String, List<String>>{
+  'dresses': ['dress', 'gown', 'jumpsuit', 'romper', 'one piece', 'onepiece'],
+  'outerwear': [
+    'outerwear',
+    'jacket',
+    'blazer',
+    'coat',
+    'hoodie',
+    'cardigan',
+    'parka',
+  ],
+  'bottoms': [
+    'bottom',
+    'pant',
+    'trouser',
+    'jean',
+    'shorts',
+    'skirt',
+    'legging',
+    'jogger',
+    'chino',
+  ],
+  'accessories': [
+    'accessor',
+    'bag',
+    'purse',
+    'hat',
+    // Plural only: a bare 'cap' would also swallow "capris".
+    'caps',
+    'glass',
+    'watch',
+    'jewel',
+    'necklace',
+    'earring',
+    'bracelet',
+    'scarf',
+    'belt',
+    'shoe',
+    'boot',
+    'sneaker',
+    'heel',
+    'sandal',
+    'loafer',
+    'sock',
+  ],
+  'tops': [
+    'top',
+    'shirt',
+    'tee',
+    'tank',
+    'blouse',
+    'polo',
+    'sweatshirt',
+    'sweater',
+    'jumper',
+    'camisole',
+  ],
+};
+
+/// Matches `dress` (or `dresses`) used as a modifier — i.e. directly followed
+/// by another word, as in "dress shirt" rather than "maxi dress".
+final _dressModifier = RegExp(r'\bdress(?:es)?\s+');
+
+/// Classifies [product] by its `category` and `subcategory` fields.
+String garmentGroupForProduct(Map<String, dynamic> product) {
+  return garmentGroupForText(
+    '${product['category'] ?? ''} ${product['subcategory'] ?? ''}',
+  );
+}
+
+/// Classifies free-text category wording into one of [garmentGroups].
+String garmentGroupForText(String value) {
+  final text = _normalize(value);
+  if (text.isEmpty) return 'other';
+
+  // "dress shirt" is a top and "dress shoes" are footwear, so when `dress`
+  // modifies a following noun, classify by that noun instead. Only trust the
+  // stripped reading when it actually names a garment — that keeps wording like
+  // "dress for summer" a dress.
+  final stripped = text.replaceFirst(_dressModifier, '');
+  if (stripped != text) {
+    final modified = _firstKeywordMatch(stripped);
+    if (modified != null) return modified;
+  }
+
+  return _firstKeywordMatch(text) ?? 'other';
+}
+
+/// Maps a garment group onto the category the FASHN try-on API expects.
+///
+/// Outerwear is sent as `tops` because FASHN layers it on the upper body; any
+/// group it cannot fit (accessories, unknown wording) falls back to `auto`.
+String fashnCategoryForGroup(String group) {
+  switch (group) {
+    case 'dresses':
+      return 'one-pieces';
+    case 'bottoms':
+      return 'bottoms';
+    case 'tops':
+    case 'outerwear':
+      return 'tops';
+    default:
+      return 'auto';
+  }
+}
+
+String? _firstKeywordMatch(String text) {
+  for (final entry in _groupKeywords.entries) {
+    for (final keyword in entry.value) {
+      if (text.contains(keyword)) return entry.key;
+    }
+  }
+  return null;
+}
+
+/// Lowercases and reduces punctuation to single spaces so that hyphenated and
+/// spaced wording ("one-piece" / "one piece") match the same keywords.
+String _normalize(String value) {
+  return value.toLowerCase().replaceAll(RegExp(r'[^a-z0-9]+'), ' ').trim();
+}
