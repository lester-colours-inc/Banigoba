rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
             && (
               firestore.get(
                 /databases/(default)/documents/users/$(request.auth.uid)
               ).data.isAdmin == true
               || firestore.get(
                 /databases/(default)/documents/users/$(request.auth.uid)
               ).data.role == "admin"
             );
    }

    // Product images available to signed-in users.
    // Sellers can only upload into their own boutique/user folder:
    // productImages/{sellerUid}/filename.jpg
    match /productImages/{boutiqueId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == boutiqueId;
    }

    // Event flyers uploaded by signed-in users for curator approval.
    match /events/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Users can only access their own images
    match /userImages/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // AI makeover source photos: ai_makeovers/{userId}/{timestamp}.jpg
    match /ai_makeovers/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Hairstyles collection
    match /hairstyles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
